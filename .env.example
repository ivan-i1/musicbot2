# Copy to .env and fill in. .env is gitignored — never commit real values.

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# Right-click your server in Discord -> Copy Server ID (requires Developer Mode)
GUILD_ID=

# OPTIONAL. Comma-separated channel IDs for the passive message tracker.
# Leave empty to track nothing (the default). Right-click a channel -> Copy Channel ID.
TRACKED_CHANNEL_IDS=

# OPTIONAL. Directory holding your music files. /play can ONLY read inside
# this directory — path traversal and symlinks pointing out of it are refused.
# Leave empty to allow http(s) links only.
MUSIC_DIR=

# OPTIONAL. /chat — a local LLM behind an OpenAI-compatible API (see README
# "Hosting" for the llm container). Chat stays OFF while LLM_BASE_URL is unset.
# On the home server: LLM_BASE_URL=http://llm:8080/v1
# Every other key below has a default; uncomment only to change it.
LLM_BASE_URL=
# LLM_MODEL=chat              # must match llama-server's --alias
# LLM_API_KEY=                # sent as "Authorization: Bearer" only if set
# LLM_MAX_TOKENS=200          # reply length cap, sent with every request
# LLM_TIMEOUT_MS=120000       # per generation, counted from when it starts
# LLM_QUEUE_MAX=3             # waiting requests, not counting the running one
# LLM_COOLDOWN_MS=20000       # per user
# LLM_GAP_MS=5000             # global pause between generations (heat guard)
# LLM_HISTORY_CHARS=2400      # per-channel history sent to the model
# LLM_TEMPERATURE=0.7
# LLM_SYSTEM_PROMPT=          # replaces the built-in persona
